# Скопируйте этот файл в .env и заполните. Положить его можно в папку backend/ или в корень проекта:
# сайт найдёт его сам. Если есть оба, важнее backend/.env. Файл .env в репозиторий НЕ коммитится.
#
# Вместо LLM_BASE_URL можно указать LLM_PROVIDER=gemini (или groq, openrouter): адрес API подставится сам.
#
# Нужен один OpenAI-совместимый сервис, у которого есть три адреса:
#   /chat/completions  — генерация ответа
#   /embeddings        — эмбеддинги для поиска по смыслу (без них работает поиск по словам)
#   /rerank            — реранкер (не обязателен, по умолчанию выключен)

# Базовый адрес API. Для проверки подойдёт любой сервис, где есть DeepSeek V4.1 Flash,
# например OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=
# Ключ доступа к этому API
LLM_API_KEY=
# Модель для ответов. На хакатоне — DeepSeek V4.1 Flash
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Модель эмбеддингов. На хакатоне — BAAI/bge-m3
EMB_MODEL=baai/bge-m3
# Модель реранкера (Qwen3 Reranker). Используется, только если включить LA_USE_RERANKER=1
RERANKER_MODEL=qwen/qwen3-reranker-8b

# Необязательные переключатели (значения по умолчанию — в core/config.py):
# LA_USE_LLM_SELF_CHECK=1   вторая проверка ответа моделью
# LA_USE_RERANKER=0         реранкер
# LA_USE_DENSE=1            поиск по смыслу
